LIVE_TRADING=false
SYMBOLS=ALL
QUOTE_CURRENCY=USDT
# 0 means all common active spot pairs.
MAX_SYMBOLS=0
MAX_NOTIONAL_QUOTE=100
# Maximum quote notional for one staged tranche.
MAX_SLICE_NOTIONAL=10
# Maximum cumulative quote notional for one active spread series per symbol.
MAX_SESSION_NOTIONAL=100
# Maximum cumulative quote notional across all symbols in the process.
MAX_TOTAL_SESSION_NOTIONAL=100
MIN_NET_EDGE_BPS=35
# Safety cap: reject implausible price anomalies above 50% net edge.
MAX_NET_EDGE_BPS=5000
POLL_INTERVAL_SECONDS=3
ORDERBOOK_LIMIT=10
# Optional fallback. Leave empty to require an authenticated MEXC fee lookup.
MEXC_FEE_BPS=
NONKYC_FEE_BPS=20
AUTO_FETCH_MEXC_FEE=true
SLIPPAGE_BUFFER_BPS=10
REQUEST_TIMEOUT_SECONDS=5
ORDER_TIMEOUT_SECONDS=2
MAX_OPEN_ORDERS=2
MAX_DAILY_LOSS_QUOTE=25
MEXC_API_KEY=
MEXC_SECRET=
NONKYC_API_KEY=
NONKYC_SECRET=
XEGGEX_API_KEY=
XEGGEX_SECRET=
XEGGEX_FEE_BPS=20
ARB_PAIR=mexc-nonkyc
MAX_BOOK_AGE_SECONDS=2
MAX_HEDGE_SLIPPAGE_BPS=75
PROTECTIVE_PRICE_LEVEL=3
TRADE_COOLDOWN_SECONDS=30
REARM_EDGE_BPS=10
